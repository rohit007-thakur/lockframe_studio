# ==============================================================================
# LOCKFRAME STUDIO — ENVIRONMENT CONFIGURATION
# Copy this file to .env and insert your real credentials.
# All values will be loaded automatically by python-dotenv.
# ==============================================================================

# 1. Fal.ai API Key (Used for SAM-2, Flux-Fill Inpainting, ControlNet, Grounded-SAM)
# Get your key at: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_ai_api_key_here

# 2. Google Gemini API Key (Used for Character Style Sheet JSON extraction & Micro-Prompt enhancement)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Database Connection URI
# Live Supabase PostgreSQL URI: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Leave empty or set to sqlite:///./lockframe.db for automatic local SQLite fallback
DATABASE_URL=sqlite:///./lockframe.db

# 4. Supabase Storage & Database Client (Optional cloud persistence)
# Project Settings -> API -> Project URL & anon/service_role API Key
# If omitted, LockFrame Studio seamlessly falls back to local disk storage in /storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
SUPABASE_BUCKET=lockframe-assets

# 5. Server Host & Port
HOST=0.0.0.0
PORT=8000
